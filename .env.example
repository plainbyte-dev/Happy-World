# Used by docker-compose.yml — copy to `.env` and fill in real values.
# Never commit the real `.env` file.

# --- admin-backend runtime env (container) ---
MONGODB_URI=mongodb://localhost:27017/tours-travels
# Generate a long random string, e.g. `openssl rand -hex 32` — required, no default.
JWT_SECRET=
# Comma-separated list of the public URLs the browser loads the frontends from.
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- frontend build arg (baked into the Next.js bundle at build time) ---
# Must be the backend's public URL/port on the host, not a Docker-network name.
NEXT_PUBLIC_API_URL=http://localhost:4000
