PORT=4000
MONGODB_URI=mongodb://localhost:27017/tours-travels
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001,https://tours-travels-admin.vercel.app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Generate a long random string, e.g. `openssl rand -hex 32` — required, no default.
JWT_SECRET=
# Gmail account that sends admin notification emails (new enquiries/custom trips).
# Needs an App Password, not the account password: myaccount.google.com/apppasswords
# (requires 2FA enabled on the account).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where notification emails are sent. Defaults to GMAIL_USER if left unset.
ADMIN_EMAIL=
